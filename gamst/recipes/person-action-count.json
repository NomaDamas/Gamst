{
  "name": "person-action-count",
  "summary": "Count a pose or movement specified by example clips, a text or a rule for every tracked person, and say who did it (an enrolled person, or unknown); no training.",
  "skill": "skills/gamst-person-action/SKILL.md",
  "hardware": {
    "min_fps": null,
    "camera": "a fixed camera that sees the person's arms and torso; the frame rate must exceed 2 x the fastest repetitions per second",
    "compute": "RTMW-l 384x288 whole-body pose + YOLOX-m detector (rtmlib ONNX; CoreML GPU on Apple silicon, ONNX Runtime CPU elsewhere), LVFace-B face and OSNet-AIN whole-body appearance for who, each in its own process and environment; MediaPipe Pose stays selectable with --pose mediapipe.pose_full"
  },
  "inputs": [
    {
      "id": "camera",
      "use": "camera",
      "sources": [
        "camera",
        "video",
        "take"
      ]
    }
  ],
  "references": [
    {
      "name": "exemplar",
      "kind": "exemplar",
      "label": "the specified pose or movement"
    },
    {
      "name": "person",
      "kind": "person",
      "label": "the enrolled person (few-shot: photos, a video range or camera seconds)",
      "for": [
        "person_binding",
        "target_person"
      ],
      "optional": true
    }
  ],
  "modules": [
    {
      "name": "pose",
      "use": "rtmw-pose",
      "candidate": "rtmw.l_384x288",
      "max_poses": 4,
      "tracker": "ocsort",
      "consumes": [
        "camera"
      ],
      "joints": "pose_joints",
      "emits": [
        "pose_joints"
      ],
      "det_every_ms": 500,
      "backlog": "spill",
      "batch": 8,
      "choose": {
        "fallback": "mediapipe.pose_full",
        "persons": 1,
        "seconds": 2
      },
      "catch_up": {
        "lag_ms": 1000,
        "max_lookback_ms": "pre_roll",
        "tail_ms": "pre_roll",
        "workers": 1,
        "min_free_pct": 25,
        "replica_mb": 2500
      }
    },
    {
      "name": "person_binding",
      "use": "person-binding",
      "optional": "on",
      "reference": "person",
      "consumes": [
        "camera",
        "pose_joints"
      ],
      "runs_without_reference": true,
      "backlog": "spill"
    },
    {
      "name": "target_person",
      "use": "target-person",
      "optional": "off",
      "reference": "person",
      "consumes": [
        "camera",
        "pose_joints"
      ],
      "joints": "target_joints",
      "emits": [
        "target_joints"
      ],
      "replaces": [
        "person_binding"
      ]
    },
    {
      "name": "pose_channels",
      "use": "pose-channels",
      "consumes": [
        "pose_joints"
      ],
      "source": "rtmw",
      "consumes_with": {
        "target_person": [
          "target_joints"
        ]
      }
    },
    {
      "name": "exemplar",
      "use": "exemplar",
      "mode": "hold",
      "max_reps_s": 2,
      "consumes": [
        "pose_joints",
        "person_binding:vision.person_binding"
      ],
      "consumes_without": {
        "person_binding": [
          "pose_joints"
        ]
      },
      "source": "rtmw",
      "per_track": true,
      "consumes_with": {
        "target_person": [
          "pose_channels",
          "target_person:vision.target_person",
          "target_joints"
        ]
      }
    },
    {
      "name": "repetition",
      "use": "repetition",
      "max_reps_s": 2,
      "consumes": [
        "pose_channels"
      ]
    },
    {
      "name": "semantic",
      "use": "semantic-scene",
      "optional": "off",
      "every_ms": 500,
      "segment_s": 4,
      "consumes": [
        "camera"
      ]
    }
  ],
  "view": "count",
  "records": [
    "temporal.exemplar_events",
    "temporal.repetition_count",
    {
      "id": "vision.person_binding",
      "for": "person_binding"
    }
  ],
  "limits": "every track is counted; who is the enrolled person bound to the track by face (or by whole-body appearance within the same video), else unknown, also retroactively within a track; a track switch by the tracker can move an identity; without --person nobody is bound until a person is enrolled (MCP enroll_person); --without person_binding leaves identity out; --with target_person counts one enrolled person only (the earlier behaviour); identity thresholds are not measured on labelled people",
  "measured": "not yet"
}
