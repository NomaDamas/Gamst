{
  "name": "person-action-count",
  "summary": "Count how many times one enrolled person makes a pose or movement they demonstrated once; no training.",
  "skill": "skills/gamst-person-action/SKILL.md",
  "hardware": {
    "min_fps": null,
    "camera": "a fixed camera that sees the person's arms and torso; the frame rate must exceed 2 x the fastest repetitions per second",
    "compute": "CPU (MediaPipe Pose Landmarker; LVFace face matching with target_person)"
  },
  "inputs": [
    {
      "id": "camera",
      "use": "camera",
      "sources": [
        "camera",
        "video",
        "take"
      ]
    }
  ],
  "references": [
    {
      "name": "exemplar",
      "kind": "exemplar",
      "label": "the demonstrated pose or movement"
    },
    {
      "name": "person",
      "kind": "person",
      "label": "the enrolled person",
      "for": "target_person"
    }
  ],
  "modules": [
    {
      "name": "pose",
      "use": "mediapipe-pose",
      "candidate": "mediapipe.pose_full",
      "max_poses": 4,
      "tracker": "ocsort",
      "consumes": [
        "camera"
      ]
    },
    {
      "name": "target_person",
      "use": "target-person",
      "optional": "on",
      "reference": "person",
      "consumes": [
        "camera",
        "pose:scene.poses"
      ]
    },
    {
      "name": "pose_channels",
      "use": "pose-channels",
      "consumes": [
        "target_person:scene.target_poses"
      ],
      "consumes_without": {
        "target_person": [
          "pose:scene.poses"
        ]
      }
    },
    {
      "name": "exemplar",
      "use": "exemplar",
      "mode": "hold",
      "max_reps_s": 2,
      "consumes": [
        "pose_channels"
      ]
    },
    {
      "name": "repetition",
      "use": "repetition",
      "max_reps_s": 2,
      "consumes": [
        "pose_channels"
      ]
    },
    {
      "name": "semantic",
      "use": "semantic-scene",
      "optional": "off",
      "every_ms": 1000,
      "consumes": [
        "camera"
      ]
    }
  ],
  "view": "count",
  "records": [
    "temporal.exemplar_events",
    "temporal.repetitions"
  ],
  "limits": "the enrolled face must be visible to confirm identity (then the track is held up to 10 s); --without target_person counts the most visible person instead; identity thresholds are not measured on people",
  "measured": "not yet"
}
