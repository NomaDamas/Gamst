{
  "name": "person-action-count",
  "summary": "Count how many times one enrolled person makes a pose or movement specified by example clips, a text or a rule; no training.",
  "skill": "skills/gamst-person-action/SKILL.md",
  "hardware": {
    "min_fps": null,
    "camera": "a fixed camera that sees the person's arms and torso; the frame rate must exceed 2 x the fastest repetitions per second",
    "compute": "CPU (MediaPipe Pose Landmarker in VIDEO mode and LVFace face matching, each in its own process and environment)"
  },
  "inputs": [
    {
      "id": "camera",
      "use": "camera",
      "sources": [
        "camera",
        "video",
        "take"
      ]
    }
  ],
  "references": [
    {
      "name": "exemplar",
      "kind": "exemplar",
      "label": "the specified pose or movement"
    },
    {
      "name": "person",
      "kind": "person",
      "label": "the enrolled person",
      "for": "target_person"
    },
    {
      "name": "verify_exemplar",
      "kind": "exemplar",
      "label": "the movement as the verification lane's pose model sees it (default: the exemplar)",
      "for": "verify_exemplar"
    }
  ],
  "modules": [
    {
      "name": "pose",
      "use": "mediapipe-pose",
      "candidate": "mediapipe.pose_full",
      "max_poses": 4,
      "tracker": "ocsort",
      "consumes": [
        "camera"
      ],
      "joints": "pose_joints",
      "emits": [
        "pose_joints"
      ],
      "sample": "newest"
    },
    {
      "name": "target_person",
      "use": "target-person",
      "optional": "on",
      "reference": "person",
      "consumes": [
        "camera",
        "pose_joints"
      ],
      "joints": "target_joints",
      "emits": [
        "target_joints"
      ]
    },
    {
      "name": "pose_channels",
      "use": "pose-channels",
      "consumes": [
        "target_joints"
      ],
      "consumes_without": {
        "target_person": [
          "pose_joints"
        ]
      }
    },
    {
      "name": "exemplar",
      "use": "exemplar",
      "mode": "hold",
      "max_reps_s": 2,
      "consumes": [
        "pose_channels",
        "target_person:vision.target_person",
        "target_joints"
      ],
      "consumes_without": {
        "target_person": [
          "pose_channels",
          "pose_joints"
        ]
      }
    },
    {
      "name": "repetition",
      "use": "repetition",
      "max_reps_s": 2,
      "consumes": [
        "pose_channels"
      ]
    },
    {
      "name": "verify_pose",
      "use": "rtmw-pose",
      "candidate": "rtmw.l_384x288",
      "optional": "off",
      "pausable": false,
      "parts": [
        "verification"
      ],
      "verifies": "pose",
      "backlog": "spill",
      "max_poses": 4,
      "tracker": "ocsort",
      "consumes": [
        "camera"
      ],
      "joints": "verify_joints",
      "emits": [
        "verify_joints"
      ],
      "det_every_ms": 500
    },
    {
      "name": "verify_channels",
      "use": "pose-channels",
      "source": "rtmw",
      "optional": "off",
      "pausable": false,
      "parts": [
        "verification"
      ],
      "consumes": [
        "verify_joints"
      ],
      "capability_id": "vision.pose_channels.verification"
    },
    {
      "name": "verify_exemplar",
      "use": "exemplar",
      "source": "rtmw",
      "reference": "verify_exemplar",
      "capability_id": "temporal.exemplar_events.verification",
      "mode": "hold",
      "max_reps_s": 2,
      "optional": "off",
      "pausable": false,
      "parts": [
        "verification"
      ],
      "consumes": [
        "verify_channels",
        "verify_joints"
      ]
    },
    {
      "name": "verification",
      "use": "count-verify",
      "verifies": "exemplar",
      "verifier": "verify_exemplar",
      "near_ms": 150,
      "optional": "off",
      "pausable": false,
      "parts": [
        "verification"
      ],
      "consumes": [
        "exemplar",
        "verify_exemplar"
      ]
    },
    {
      "name": "semantic",
      "use": "semantic-scene",
      "optional": "off",
      "every_ms": 500,
      "segment_s": 4,
      "consumes": [
        "camera"
      ]
    }
  ],
  "view": "count",
  "records": [
    "temporal.exemplar_events",
    "temporal.repetition_count"
  ],
  "limits": "the enrolled face must be visible to confirm identity (then the track is held up to 10 s); --without target_person counts the most visible person instead; identity thresholds are not measured on people",
  "measured": "not yet"
}
