   "consumes": [
    "camera"
   ],
   "joints": "pose_joints",
   "emits": [
    "pose_joints"
   ],
   "det_every_ms": 500,
   "backlog": "spill",
   "batch": 8,
   "choose": {
    "fallback": "mediapipe.pose_full",
    "persons": 1,
    "seconds": 2
   },
   "catch_up": {
    "lag_ms": 1000,
    "max_lookback_ms": "pre_roll",
    "tail_ms": "pre_roll",
    "workers": 1,
    "min_free_pct": 25,
    "replica_mb": 2500
   }
  },
  {
   "name": "pose_channels",
   "use": "pose-channels",
   "consumes": [
    "pose_joints"
   ],
   "source": "rtmw"
  },
  {
   "name": "exemplar",
   "use": "exemplar",
   "mode": "sequence",
   "max_reps_s": 1,
   "consumes": [
    "pose_channels",
    "pose_joints"
   ],
   "source": "rtmw"
  },
  {
   "name": "onsets",
   "use": "audio-onsets",
   "optional": "on",
   "consumes": [
    "microphone"
   ]
  },
  {
   "name": "impact",
   "use": "coincidence",
   "optional": "on",
   "of": "exemplar",
   "by": "onsets",
   "of_event": "exemplar.matched",
   "by_event": "audio.onset",
   "before_ms": 600,
   "after_ms": 200,
   "consumes": [
    "exemplar",
    "onsets"
   ]
  },
  {
   "name": "form",
   "use": "form",
   "channels": "pose_channels",
   "exemplar": "exemplar",
   "reference": "exemplar",
   "consumes": [
    "pose_channels",
    "exemplar"
   ]
  }
 ],
 "stacks": {
  "default": "sota",
  "sota": {
   "summary": "RTMW-l whole-body pose (COCO-WholeBody 70.1 AP), MediaPipe full when it cannot keep up (#373 rule)",
   "modules": {},
   "post": {
    "modules": {
