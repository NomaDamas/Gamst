{
 "name": "swing",
 "summary": "Count swings (golf, baseball, tennis strokes) that match a demonstrated swing, mark the ones that made an impact sound, and compare each swing's joint angles with the demonstration.",
 "skill": "skills/gamst-sports/SKILL.md",
 "category": "sports",
 "hardware": {
  "min_fps": null,
  "camera": "a fixed side or front camera on the player; 60 fps or more for the fastest phase",
  "microphone": "the camera's sound (optional: --without onsets)",
  "compute": "one pose model in its own environment"
 },
 "inputs": [
  {
   "id": "camera",
   "use": "camera",
   "sources": [
    "camera",
    "video",
    "take"
   ]
  },
  {
   "id": "microphone",
   "use": "microphone",
   "sources": [
    "microphone",
    "audio",
    "video"
   ]
  }
 ],
