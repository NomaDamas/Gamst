{
  "name": "person-term-count",
  "summary": "Count how often chosen words are said: by one enrolled person (default), or by anyone (--without voice).",
  "skill": "skills/gamst-person-terms/SKILL.md",
  "hardware": {
    "min_fps": null,
    "microphone": "16 kHz mono",
    "compute": "CPU (CAM++ speaker embedding, faster-whisper small)"
  },
  "inputs": [
    {
      "id": "microphone",
      "use": "microphone",
      "sources": [
        "microphone",
        "audio",
        "video"
      ]
    }
  ],
  "references": [
    {
      "name": "voice",
      "kind": "voice",
      "label": "the enrolled voice",
      "for": [
        "speaker",
        "target_voice",
        "speaker_check",
        "identify"
      ]
    },
    {
      "name": "terms",
      "kind": "terms",
      "label": "the words to count"
    }
  ],
  "modules": [
    {
      "name": "speaker",
      "use": "speaker-verify",
      "reference": "voice",
      "consumes": [
        "microphone"
      ],
      "optional": "off",
      "pausable": false,
      "parts": [
        "voice"
      ]
    },
    {
      "name": "target_voice",
      "use": "speaker-gate",
      "reference": "voice",
      "consumes": [
        "microphone",
        "speaker"
      ],
      "emits": [
        "voice"
      ],
      "optional": "off",
      "pausable": false,
      "parts": [
        "voice"
      ]
    },
    {
      "name": "separation",
      "use": "speaker-sources",
      "consumes": [
        "microphone"
      ],
      "emits": [
        "sources"
      ],
      "optional": "off",
      "pausable": false,
      "parts": [
        "overlap"
      ],
      "block_ms": 8000,
      "context_ms": 4000
    },
    {
      "name": "identify",
      "use": "hosted-identify",
      "reference": "voice",
      "consumes": [
        "microphone"
      ],
      "optional": "off",
      "pausable": false,
      "parts": [
        "hosted"
      ],
      "block_ms": 60000
    },
    {
      "name": "asr",
      "use": "whisper-words",
      "language": "ko",
      "consumes": [
        "voice"
      ],
      "consumes_without": {
        "target_voice": [
          "microphone"
        ]
      },
      "segmentation": "phrases",
      "hop_seconds": 4.0,
      "margin_seconds": 3.0,
      "max_seconds": 25.0
    },
    {
      "name": "speaker_check",
      "use": "speaker-verify",
      "reference": "voice",
      "segments": false,
      "capability_id": "speech.speaker_check",
      "consumes": [
        "microphone",
        "asr:speech.transcript_words"
      ],
      "optional": "on",
      "pausable": false,
      "parts": [
        "voice"
      ],
      "context_ms": 1500,
      "words": true,
      "sources": "sources",
      "turns": "identify",
      "consumes_optional": [
        "sources",
        "identify"
      ]
    },
    {
      "name": "terms",
      "use": "terms",
      "reference": "terms",
      "consumes": [
        "speaker_check"
      ],
      "consumes_without": {
        "speaker_check": [
          "asr:speech.transcript_words"
        ]
      },
      "report_others": true
    }
  ],
  "view": "count",
  "records": [
    "speech.term_events"
  ],
  "limits": "overlapping voices are not separated by default: --with overlap scores each word on PixIT's separated per-speaker sources (pyannote, gated weights; slower than real time on a Mac CPU), --with target_voice mutes other voices before the words are read; --with hosted adds pyannoteAI identification as evidence beside each word (audio leaves the device, billed); the speaker threshold must be set on your own audio; a phrase two people share gets one verdict; what another voice said is reported (term.other_voice) and never counted; --without voice counts every voice and says so (speaker: not_bound)",
  "measured": "one 54 s clip of several people in a noisy shop (2026-11-26): see docs/measurements/testbed-2026-11-26.md"
}
